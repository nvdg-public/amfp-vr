{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "Amnesia: A Machine for Pigs VR - Steam Frame controllers default",
  "description": "Left stick walks (click = run), right stick snap-turns (click = recenter). Right grip grabs objects, right trigger interacts; the left grip and trigger do the same. Left grip at the left hip takes the lantern. A crouch, B jump, left d-pad down journal, View or Menu pause menu.",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/interact"
            },
            "pull": {
              "output": "/actions/main/in/interact_pull"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/crouch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/jump"
            }
          }
        },
        {
          "path": "/user/hand/right/input/menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/menu"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/turn"
            },
            "click": {
              "output": "/actions/main/in/recenter"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/interact_left"
            },
            "pull": {
              "output": "/actions/main/in/interact_left_pull"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/rotate"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_down",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/journal"
            }
          }
        },
        {
          "path": "/user/hand/left/input/view",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/menu"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/move"
            },
            "click": {
              "output": "/actions/main/in/run"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/aim_left",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/main/in/aim_right",
          "path": "/user/hand/right/pose/tip"
        },
        {
          "output": "/actions/main/in/grip_left",
          "path": "/user/hand/left/pose/grip"
        },
        {
          "output": "/actions/main/in/grip_right",
          "path": "/user/hand/right/pose/grip"
        }
      ],
      "skeleton": [
        {
          "output": "/actions/main/in/skeleton_left",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/main/in/skeleton_right",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ],
      "haptics": [
        {
          "output": "/actions/main/out/haptic_left",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/main/out/haptic_right",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}
